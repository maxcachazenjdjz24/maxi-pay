    "chalk": "^5.3.0",
    "cron-parser": "^5.10.0",
    "js-tiktoken": "^1.0.21",
    "jose": "^5.9.6",
    "openai": "^7.9.0",
    "ulid": "^2.3.0",
    "viem": "^2.44.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
