{
  "name": "mi-automaton",
  "version": "0.1.0",
  "description": "Agente autónomo propio, inspirado en Conway Automaton (Conway-Research/automaton, MIT), corriendo en infraestructura propia.",
  "main": "main.js",
  "bin": {
    "automaton": "main.js"
  },
  "scripts": {
    "start": "node main.js",
    "start:web": "node web-server.js",
    "start:bot": "node telegram-bot.js",
    "start:automaton": "node dist/index.js --run",
    "build": "tsc",
    "setup": "node dist/index.js --setup",
    "status": "node dist/index.js --status",
    "approvals": "node dist/approvals-cli.js"
  },
  "license": "MIT",
